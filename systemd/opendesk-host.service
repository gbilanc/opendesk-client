[Unit]
Description=OpenDesk Host (incoming-only)
After=network.target
Wants=network-online.target

[Service]
Type=simple
# GUI app: serve DISPLAY per l'icona ID/password (sistema con display server attivo)
Environment=DISPLAY=:0
ExecStart=/home/giampaolo/Codium/opendesk-client/.venv/bin/opendesk-host --log-level=WARNING
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal
Environment=OPENDESK_LOG_LEVEL=WARNING

[Install]
WantedBy=multi-user.target
