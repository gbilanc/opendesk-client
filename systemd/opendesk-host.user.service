[Unit]
Description=OpenDesk Host (incoming-only)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
# Servizio utente: eredita DISPLAY / WAYLAND_DISPLAY / XAUTHORITY / XDG_RUNTIME_DIR
# dal systemd --user della sessione grafica, senza bisogno di privilegi root.
# Verifica con: systemctl --user show-environment
ExecStart=/home/giampaolo/Codium/opendesk-client/.venv/bin/opendesk-host --minimized
Restart=on-failure
RestartSec=10
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
